# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git에 올리지 않는다.

# MongoDB Atlas 연결 문자열 (DB 이름을 빼면 ax_platform을 쓴다)
MONGO_DETAILS=

# 로그인 토큰 서명 키. 아래 명령으로 만든 값을 넣는다.
#   docker run --rm python:3.11-slim-bookworm python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# HTTPS로 배포할 때만 true
COOKIE_SECURE=false

# AI 채팅. demo는 실제 호출 없는 모의 응답이다. openai로 바꾸면 아래 주소로 호출하고 비용(크레딧)이 든다.
AI_PROVIDER=demo
# OpenAI 키, 또는 BAZE 게이트웨이 키(BAZE 로그인 → 왼쪽 아래 API Gateway → API 키 생성. 만든 뒤 다시 볼 수 없다)
OPENAI_API_KEY=
# OpenAI 호환 주소. OpenAI는 https://api.openai.com/v1, BAZE 게이트웨이는 https://api.baze.co/v1/gateway
OPENAI_BASE_URL=https://api.openai.com/v1
# Responses API 모델. BAZE 게이트웨이 목록에 있는 것: gpt-6-luna, gpt-6-sol, gpt-6.1-sol, gpt-6.1-terra, gpt-5.2 등
OPENAI_MODEL=gpt-6-luna
# 추론 정도. 비우면 OpenAI는 none, 게이트웨이는 low. 게이트웨이는 low·medium·high만 받는다.
OPENAI_REASONING_EFFORT=

# 허용 범위의 첨부 파일(TXT·MD·DOCX) 원문 읽기. 현행 AI Pipeline 계약의 기본은 true
AI_READ_ATTACHMENTS=true
# 채팅에 붙인 사진(PNG·JPEG·WebP)을 AI가 보게 할지. 기본 true(한 메시지에 4장까지, 긴 변 1568px로 줄여 보냄)
AI_READ_IMAGES=true
